{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcn": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ]
    },
    "reactbits": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@react-bits/mcp"
      ]
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "AQ.Ab8RN6J2Duu0_PncjVwRpvnx0Cs0z2VGAjDwXd23Xa919svU0g"
      }
    },
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "react": {
      "enabled": true,
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-react"
      ]
    },
    "puppeteer": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    }
  }
}
